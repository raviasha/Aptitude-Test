    "176": {"question_text": "[8(3.75)³ + 1] ÷ [(7.5)² − 6.5] is equal to (S.S.C., 2003)", "options": {"A": "9/5", "B": "2.75", "C": "4.75", "D": "8.5"}, "solution_steps": ["8(3.75)³ = 7.5³, and (7.5)² − 6.5 = 7.5² − 7.5 × 1 + 1².", "The expression is (7.5³ + 1³) ÷ (7.5² − 7.5 × 1 + 1²) = 7.5 + 1 = 8.5."], "question_review": "codex-vision-page-91", "solution_review": "codex-vision-page-101", "solution_pages": [101]},
    "177": {"question_text": "The value of (0.1³ + 0.02³) ÷ (0.2³ + 0.04³) is (Hotel Management 2003; S.S.C., 2005)", "solution_steps": ["0.2³ + 0.04³ = 2³(0.1³ + 0.02³).", "Therefore, the expression is 1 ÷ 2³ = 1/8 = 0.125."], "question_review": "codex-vision-page-91", "solution_review": "codex-vision-page-101", "solution_pages": [101]},
    "178": {"question_text": "[(0.013)³ + 0.000000343] ÷ [(0.013)² − 0.000091 + 0.000049] = ? (I.I.F.T., 2005)", "solution_steps": ["0.000000343 = 0.007³, 0.000091 = 0.013 × 0.007, and 0.000049 = 0.007².", "The expression is (a³ + b³) ÷ (a² − ab + b²) = a + b.", "Therefore, the value is 0.013 + 0.007 = 0.020."], "question_review": "codex-vision-page-92", "solution_review": "codex-vision-page-101", "solution_pages": [101]},
    "179": {"question_text": "The value of [(2.3)³ − 0.027] ÷ [(2.3)² + 0.69 + 0.09] is (R.R.B., 2005)", "solution_steps": ["Write 0.027 = 0.3³, 0.69 = 2.3 × 0.3, and 0.09 = 0.3².", "The expression is (a³ − b³) ÷ (a² + ab + b²) = a − b.", "Therefore, the value is 2.3 − 0.3 = 2."], "question_review": "codex-vision-page-92", "solution_review": "codex-vision-page-101", "solution_pages": [101]},
