    "169": {"question_text": "The value of [(2.697 − 0.498)² + (2.697 + 0.498)²] ÷ (2.697² + 0.498²) is", "solution_steps": ["Use (a − b)² + (a + b)² = 2(a² + b²).", "The expression is 2(a² + b²) ÷ (a² + b²) = 2."], "question_review": "codex-vision-page-91", "solution_review": "codex-vision-page-101", "solution_pages": [101]},
    "170": {"question_text": "The value of [(0.137 + 0.098)² − (0.137 − 0.098)²] ÷ (0.137 × 0.098) is", "solution_steps": ["Use (a + b)² − (a − b)² = 4ab.", "The expression is 4ab ÷ ab = 4."], "question_review": "codex-vision-page-91", "solution_review": "codex-vision-page-101", "solution_pages": [101]},
    "171": {"question_text": "The value of (0.051³ + 0.041³) ÷ (0.051² − 0.051 × 0.041 + 0.041²) is (S.S.C., 2003)", "solution_steps": ["Use a³ + b³ = (a + b)(a² − ab + b²).", "The expression reduces to a + b = 0.051 + 0.041 = 0.092."], "question_review": "codex-vision-page-91", "solution_review": "codex-vision-page-101", "solution_pages": [101]},
    "172": {"question_text": "The value of (5.71³ − 2.79³) ÷ (5.71² + 5.71 × 2.79 + 2.79²) is (S.S.C., 2005)", "solution_steps": ["Use a³ − b³ = (a − b)(a² + ab + b²).", "The expression reduces to a − b = 5.71 − 2.79 = 2.92."], "question_review": "codex-vision-page-91", "solution_review": "codex-vision-page-101", "solution_pages": [101]},
