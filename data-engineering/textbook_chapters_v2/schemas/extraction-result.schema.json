{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Textbook V2 extraction result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "job_fingerprint",
    "question_text",
    "options",
    "correct_answer",
    "solution_steps",
    "representation",
    "differences_from_legacy",
    "reviewer"
  ],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "job_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "question_text": {"type": "string", "minLength": 1},
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D"],
      "minProperties": 4,
      "maxProperties": 5,
      "properties": {
        "A": {"type": "string", "minLength": 1},
        "B": {"type": "string", "minLength": 1},
        "C": {"type": "string", "minLength": 1},
        "D": {"type": "string", "minLength": 1},
        "E": {"type": "string", "minLength": 1}
      }
    },
    "correct_answer": {"enum": ["A", "B", "C", "D", "E"]},
    "solution_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "options", "solution"],
      "properties": {
        "question": {"enum": ["text", "image", "quarantine"]},
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B", "C", "D"],
          "minProperties": 4,
          "maxProperties": 5,
          "properties": {
            "A": {"enum": ["text", "image", "quarantine"]},
            "B": {"enum": ["text", "image", "quarantine"]},
            "C": {"enum": ["text", "image", "quarantine"]},
            "D": {"enum": ["text", "image", "quarantine"]},
            "E": {"enum": ["text", "image", "quarantine"]}
          }
        },
        "solution": {"enum": ["text", "image", "quarantine"]}
      }
    },
    "differences_from_legacy": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reviewer": {"type": "string", "minLength": 1}
  }
}
